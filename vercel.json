{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api?__path=/v1/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api?__path=/v1/:path*"
    }
  ]
}
