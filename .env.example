# Server only — never shipped inside the Chrome extension.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Extension talks to this API.
# Local: http://127.0.0.1:8787
# Production: your Vercel URL, e.g. https://context-x.vercel.app
VITE_CONTEXT_X_API_URL=http://127.0.0.1:8787
PORT=8787
